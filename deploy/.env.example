# deploy/.env.example — copy to /opt/preplai/.env on the server
# NEVER commit .env to version control

# MongoDB (required) — DigitalOcean Managed DB or MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/preplai?retryWrites=true&w=majority

# JWT secret for API auth (required)
# Generate: openssl rand -hex 32
JWT_SECRET=your-64-char-hex-secret
