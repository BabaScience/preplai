# apps/api — Preplai SaaS API
# Copy to .env and fill in values. Never commit .env to version control.

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/preplai

# Server
PORT=5000

# JWT signing secret for auth tokens (required in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-change-in-production

# CORS allowed origins (comma-separated)
# Default: http://localhost:5173 when unset
ALLOWED_ORIGINS=http://localhost:5173,https://preplai.com

# Player base URL (MCP server URL for session player links)
# Default: http://localhost:5005 for local dev
PLAYER_BASE_URL=http://localhost:5005

# Optional: development | production | test
# NODE_ENV=development
