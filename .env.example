# .env.example
# Copy to .env and fill in values. Never commit .env to version control.
#
# Shared by apps/api and packages/mcp-server

# MongoDB connection string (required for both API and MCP server)
MONGODB_URI=mongodb://localhost:27017/preplai

# ── API server (apps/api) ─────────────────────────────────────────
PORT=5000
JWT_SECRET=your-jwt-secret-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,https://preplai.com

# ── MCP server (packages/mcp-server) ──────────────────────────────
PORT=5005
BASE_URL=http://localhost:5005
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5005
LOG_LEVEL=info
