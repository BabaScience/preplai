# Dockerfile.api — Preplai API (Express)
# Build from repo root: docker build -f Dockerfile.api .
FROM node:20-slim

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/ apps/
COPY packages/ packages/

RUN npm ci
RUN npm run build --workspace=@preplai/db --if-present

ENV NODE_ENV=production
EXPOSE 5000
CMD ["node", "apps/api/src/index.js"]
