# .env.production.example — Production environment template for preplai.com
# Copy to .env on the server (e.g. /opt/preplai/.env)
# NEVER commit .env with real values to version control
#
# Generate JWT_SECRET: openssl rand -hex 32

# ── Required ─────────────────────────────────────────────────────────────

# MongoDB connection string (DigitalOcean Managed DB or MongoDB Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/preplai?retryWrites=true&w=majority

# JWT secret for API auth — REQUIRED in production
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL

# ── Optional (docker-compose has defaults for preplai.com) ───────────────
# Uncomment to override. docker-compose hardcodes these for preplai.com:
#   ALLOWED_ORIGINS, PLAYER_BASE_URL, BASE_URL

ALLOWED_ORIGINS=https://preplai.com,https://www.preplai.com,https://api.preplai.com,https://player.preplai.com
PLAYER_BASE_URL=https://player.preplai.com
BASE_URL=https://player.preplai.com

# Monitoring dashboard: API fetches MCP health/metrics. In Docker, uses http://mcp:5005 internally.
# MCP_BASE_URL=http://mcp:5005

# Admin users can access /monitoring. Promote a user: pnpm --filter preplai-api run promote-admin -- user@example.com
# Or run seed to create admin@preplai.com (password: admin123) for local dev.

# LOG_LEVEL=info

# Optional: Sentry error tracking. When set, unhandled errors and rejections are sent to Sentry.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Resend: welcome emails on signup. Get key at resend.com
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM=Preplai <hello@preplai.com>
# APP_URL=https://preplai.com

# ── ElevenLabs TTS (voice-synced narration) ──────────────────────────
# When set, the MCP server generates MP3 audio with word-level timestamps.
# Without it, the player falls back to browser Web Speech API.
# Get your key at: https://elevenlabs.io/app/api-keys
ELEVENLABS_API_KEY=
# Optional: override default voice/model
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Anthropic (semantic focus cue generation) ─────────────────────────
# When set, Claude Haiku analyzes narration to resolve synonyms, pronouns,
# and group references to entity IDs for intelligent focus highlighting.
# Without it, falls back to string matching (still works, just less smart).
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
