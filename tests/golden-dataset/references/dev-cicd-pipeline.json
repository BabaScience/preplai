      "endTime": 15000,
      "description": "Production deployment with rollback",
      "narrationSegment": "Production deployment uses a blue-green strategy. The new version v2.4 is deployed alongside v2.3, traffic is gradually shifted using weighted routing, and if error rates exceed 1 percent, an automatic rollback kicks in within 60 seconds. Prometheus monitors error rates in real-time. This gives zero-downtime deployments with built-in safety nets.",
      "entities": [
        { "id": "h1", "type": "H1", "position": { "x": 50, "y": 8 }, "label": "CI/CD Pipeline" },
        { "id": "staging", "type": "Deployment", "position": { "x": 15, "y": 42 }, "label": "Staging ✓", "metadata": { "environment": "staging", "status": "live" } },
        { "id": "prod", "type": "Deployment", "position": { "x": 42, "y": 42 }, "label": "Production v2.4", "metadata": { "environment": "production", "version": "v2.4", "status": "live" }, "highlight": true },
