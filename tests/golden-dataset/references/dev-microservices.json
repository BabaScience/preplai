        { "id": "a4", "type": "DottedArrow", "position": { "x": 36, "y": 48 }, "sourceEntityId": "auth-svc", "targetEntityId": "monitor", "label": "metrics" },
        { "id": "a5", "type": "Arrow", "position": { "x": 64, "y": 62 }, "sourceEntityId": "monitor", "targetEntityId": "alert" },
        { "id": "l1", "type": "Label", "position": { "x": 50, "y": 85 }, "label": "Containerized, orchestrated, and fully observable — 15s scrape interval" }
      ]
    }
