# Dockerfile.website — Preplai Website (Vite React)
# Build from repo root: docker build -f Dockerfile.website --build-arg VITE_API_URL=https://api.preplai.com/api .
FROM node:20-slim AS build
WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@10.16.1 --activate

# Copy workspace config and lockfile
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/ apps/
COPY packages/ packages/

RUN pnpm install --frozen-lockfile

# Build workspace packages the website depends on (shared → illustrations → player)
RUN pnpm --filter @preplai/shared run build && \
    pnpm --filter @preplai/illustrations run build && \
    pnpm --filter @preplai/player run build

ARG VITE_API_URL=https://api.preplai.com/api
ARG VITE_GA_ID=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GA_ID=$VITE_GA_ID
RUN pnpm --filter website run build

FROM nginx:alpine
COPY --from=build /app/apps/website/dist /usr/share/nginx/html
COPY deploy/nginx-website.conf /etc/nginx/conf.d/default.conf
