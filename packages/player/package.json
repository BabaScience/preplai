{
  "name": "@preplai/player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "vite build && vite build -c vite.mcp-app.config.ts",
    "build:mcp-app": "vite build -c vite.mcp-app.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@preplai/illustrations": "workspace:*",
    "@preplai/shared": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
