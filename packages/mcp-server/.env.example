# packages/mcp-server — Preplai MCP Server
# Copy to .env and fill in values. Never commit .env to version control.

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/preplai

# OAuth (required for Claude Web connector; must match API's JWT_SECRET)
JWT_SECRET=preplai-dev-secret-change-in-prod

# Server
PORT=5005
BASE_URL=http://localhost:5005

# Set OPEN_PLAYER_IN_BROWSER=true to auto-open player when create_session is called (useful when BASE_URL is remote but server runs on your machine)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5005

# Logging
LOG_LEVEL=info
