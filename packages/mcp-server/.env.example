# packages/mcp-server — Preplai MCP Server
# Copy to .env and fill in values. Never commit .env to version control.

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/preplai

# Server
PORT=5005
BASE_URL=http://localhost:5005
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5005

# Logging
LOG_LEVEL=info
