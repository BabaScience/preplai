{
  "name": "@preplai/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Cinema-quality visual presentations as an agent-native MCP API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../player/dist/mcp-app.html dist/mcp-app.html 2>/dev/null || true && cp -r src/tool-descriptions dist/tool-descriptions",
    "start": "node dist/server.js",
    "start:mcp": "node dist/stdio-bridge.js",
    "dev": "node --watch dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sse": "^0.4.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@preplai/compiler": "workspace:*",
    "@preplai/db": "workspace:*",
    "@preplai/illustrations": "workspace:*",
    "@preplai/player": "workspace:*",
    "@preplai/shared": "workspace:*",
    "@sentry/node": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-mcp-server": "*",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "prom-client": "^15.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "mongodb-memory-server": "^11.0.1"
  }
}
