{
  "name": "@preplai/mcp-server",
  "version": "0.1.0",
  "description": "Cinema-quality visual presentations as an agent-native MCP API. Turn structured tool calls into live SVG + GSAP animations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "preplai": "./dist/server.js",
    "preplai-mcp": "./dist/stdio-bridge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "mcp",
    "presentation",
    "svg",
    "animation",
    "gsap",
    "claude",
    "ai",
    "agent",
    "visual",
    "cinema"
  ],
  "author": "BabaScience",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BabaScience/preplai"
  },
  "homepage": "https://github.com/BabaScience/preplai#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mcp": "node dist/stdio-bridge.js",
    "dev": "node --watch dist/server.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@preplai/shared": "*",
    "@preplai/compiler": "*",
    "fastify": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "fastify-mcp-server": "*",
    "@fastify/cors": "^10.0.0",
    "@fastify/sse": "^3.0.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0"
  }
}
