{
  "name": "@preplai/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Cinema-quality visual presentations as an agent-native MCP API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mcp": "node dist/stdio-bridge.js",
    "dev": "node --watch dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@preplai/shared": "*",
    "@preplai/compiler": "*",
    "fastify": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "fastify-mcp-server": "*",
    "@fastify/cors": "^10.0.0",
    "@fastify/sse": "^3.0.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0"
  }
}
