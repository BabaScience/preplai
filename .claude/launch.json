{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "website", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "mcp-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@preplai/mcp-server", "run", "dev"],
      "port": 5005,
      "env": { "PORT": "5005" }
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/api/src/index.js"],
      "port": 5001,
      "env": { "PORT": "5001" },
      "autoPort": false
    }
  ]
}
